rules_version = '2';

// Starting point that mirrors the model documented in firestore-schema.md.
// Review and tighten before going to production.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Membership lives on the group document, so a member reading the group needs no extra lookup
    // and "my groups" is a single query. `.get(field, [])` because a field a document does not have
    // raises an error, which would deny the whole request instead of just this branch.
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }
    function isMember(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).get('memberUids', []);
    }
    function isAdmin(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).get('adminUids', []);
    }
    // `.get(field, [])` and not `.data.calendarSharedWith`: reading a field a document does not
    // have raises an error, which denies the whole request instead of just this branch.
    function ownerOrShared(uid) {
      return isSignedIn() && (request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('calendarSharedWith', []));
    }
    // The public profile: the name, plus the `calendarSharedWith` grant list the rules and the
    // sharing query both need. Anything else about a user lives under `private`.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid ||
        request.auth.uid in resource.data.get('calendarSharedWith', []));
      allow write: if isSignedIn() && request.auth.uid == uid;

      // Email, FCM tokens and entitlement: never readable by anyone else.
      // `allow` rules are additive, so the wildcard has to exclude `subscription` explicitly —
      // otherwise it would grant the write that the rule below denies.
      match /private/{docId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid && docId != 'subscription';
      }
      // Entitlement is server-verified: only the receipt-verification Cloud Function writes it.
      match /private/subscription {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Personal event types & events: owner writes; owner and shared users read.
      match /personalEventTypes/{typeId} {
        allow read: if ownerOrShared(uid);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /personalEvents/{eventId} {
        allow read: if ownerOrShared(uid);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      // Sync timestamps the owner bumps on every write; readers use them to check their cache.
      match /sync/{docId} {
        allow read: if ownerOrShared(uid);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

    }

    // Username reservations. Readable by any signed-in user: this is how you find someone whose
    // `users/{uid}` you cannot read yet. Uniqueness comes from `create` only firing when the
    // document does not exist — a second claimant lands on `update` and is denied.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username;
      // The owner may refresh their display name, never hand the reservation to someone else.
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.username == resource.data.username;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      // Read straight off the document being read — no lookup, and it makes the "my groups" query
      // (`memberUids array-contains me`) return exactly the documents this rule allows.
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('memberUids', []);
      allow create: if isSignedIn() &&
        request.resource.data.get('memberUids', []) == [request.auth.uid] &&
        request.resource.data.get('adminUids', []) == [request.auth.uid];
      // Membership is granted by the acceptJoinRequest Cloud Function, never by a client.
      allow update: if isAdmin(groupId) &&
        request.resource.data.get('memberUids', []) == resource.data.get('memberUids', []) &&
        request.resource.data.get('adminUids', []) == resource.data.get('adminUids', []);
      allow delete: if isAdmin(groupId);

      // Group events live in one collection per group, not one per member: a group's calendar is
      // a single query, and a transfer changes `assigneeId` instead of moving the document.
      match /events/{eventId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.assigneeId == request.auth.uid;
        // ownerId is the creator forever, and assigneeId only changes through takeEvent.
        allow update: if isMember(groupId) &&
          (resource.data.assigneeId == request.auth.uid || isAdmin(groupId)) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.assigneeId == resource.data.assigneeId;
        allow delete: if isMember(groupId) &&
          (resource.data.assigneeId == request.auth.uid || isAdmin(groupId));

        // Append-only history alongside the event.
        match /history/{historyId} {
          allow read: if isMember(groupId);
          allow create: if isMember(groupId);
          allow update, delete: if false;
        }
      }

      // When each month of the group's calendar last changed: any member's write moves it.
      match /sync/{docId} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId);
      }

      // Join requests: created only by requestToJoinGroup (Cloud Function).
      match /joinRequests/{requestUid} {
        allow read: if isAdmin(groupId) || (isSignedIn() && request.auth.uid == requestUid);
        allow create: if false;
        allow delete: if isAdmin(groupId) || (isSignedIn() && request.auth.uid == requestUid);
        allow update: if false;
      }
    }
  }
}
