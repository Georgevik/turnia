rules_version = '2';

// Starting point that mirrors the model documented in firestore-schema.md.
// Review and tighten before going to production.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Membership lives on the group document, so a member reading the group needs no extra lookup
    // and "my groups" is a single query. `.get(field, [])` because a field a document does not have
    // raises an error, which would deny the whole request instead of just this branch.
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }
    function isMember(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).get('memberUids', []);
    }
    function isAdmin(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).get('adminUids', []);
    }
    // A former member who still holds events here: they read their own events and nothing else,
    // not even the group document, which carries the member roster and the invitation code.
    function isRevoked(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).get('revokedUids', []);
    }
    // `.get(field, [])` and not `.data.calendarSharedWith`: reading a field a document does not
    // have raises an error, which denies the whole request instead of just this branch.
    function ownerOrShared(uid) {
      return isSignedIn() && (request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('calendarSharedWith', []));
    }
    // The public profile: the name, plus the `calendarSharedWith` grant list the rules and the
    // sharing query both need. Anything else about a user lives under `private`.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid ||
        request.auth.uid in resource.data.get('calendarSharedWith', []));
      allow create: if isSignedIn() && request.auth.uid == uid;
      // `name` and `username` are copied into every group the user belongs to, so only the
      // `updateProfile` function may change them — a keeper that ships inside the app is only as
      // current as the oldest version still installed.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.get('name', '') == resource.data.get('name', '') &&
        request.resource.data.get('username', '') == resource.data.get('username', '');
      allow delete: if isSignedIn() && request.auth.uid == uid;

      // Email, FCM tokens and entitlement: never readable by anyone else.
      // `allow` rules are additive, so the wildcard has to exclude `subscription` explicitly —
      // otherwise it would grant the write that the rule below denies.
      match /private/{docId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid && docId != 'subscription';
      }
      // Entitlement is server-verified: only the receipt-verification Cloud Function writes it.
      match /private/subscription {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Personal event types & events: owner writes; owner and shared users read.
      match /personalEventTypes/{typeId} {
        allow read: if ownerOrShared(uid);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /personalEvents/{eventId} {
        allow read: if ownerOrShared(uid);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      // Sync timestamps the owner bumps on every write; readers use them to check their cache.
      match /sync/{docId} {
        allow read: if ownerOrShared(uid);
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      // Groups the user was removed from, with the event types their leftover events use. It is
      // what lets them render those events without reading the group document they lost access to,
      // so only leaveGroup / removeMember may write it.
      match /revokedGroups/{groupId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

    }

    // Username reservations. Readable by any signed-in user: this is how you find someone whose
    // `users/{uid}` you cannot read yet. Uniqueness comes from `create` only firing when the
    // document does not exist — a second claimant lands on `update` and is denied.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username;
      // Renaming means moving a reservation *and* every copy of the name; `updateProfile` owns it.
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      // Read straight off the document being read — no lookup, and it makes the "my groups" query
      // (`memberUids array-contains me`) return exactly the documents this rule allows.
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('memberUids', []);
      allow create: if isSignedIn() &&
        request.resource.data.get('memberUids', []) == [request.auth.uid] &&
        request.resource.data.get('adminUids', []) == [request.auth.uid];
      // Membership is granted by the acceptJoinRequest Cloud Function and withdrawn by
      // leaveGroup / removeMember, never by a client.
      allow update: if isAdmin(groupId) &&
        request.resource.data.get('memberUids', []) == resource.data.get('memberUids', []) &&
        request.resource.data.get('adminUids', []) == resource.data.get('adminUids', []) &&
        request.resource.data.get('revokedUids', []) == resource.data.get('revokedUids', []);
      allow delete: if isAdmin(groupId);

      // Group events live in one collection per group, not one per member: a group's calendar is
      // a single query, and a transfer changes `assigneeId` instead of moving the document.
      match /events/{eventId} {
        // A revoked user keeps only what is still assigned to them. On a `list` the
        // `resource.data.assigneeId` term is what forces their query to carry the matching
        // `assigneeId ==` filter; without it Firestore denies the whole query.
        allow read: if isMember(groupId) ||
          (isRevoked(groupId) && resource.data.assigneeId == request.auth.uid);
        allow create: if isMember(groupId) &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.assigneeId == request.auth.uid;
        // ownerId is the creator forever, assigneeId only changes through takeEvent, and the
        // history only grows there too — frozen here, it cannot be rewritten by anyone but the
        // function, which is a firmer append-only than a subcollection of member-writable entries.
        // A revoked user gets the second branch only: deleting is a soft delete, so it arrives
        // here as an update, and theirs is narrowed to flipping `isDeleted` on an event they
        // created and still hold.
        allow update: if (isMember(groupId) &&
          (resource.data.assigneeId == request.auth.uid || isAdmin(groupId)) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.assigneeId == resource.data.assigneeId &&
          request.resource.data.get('history', []) == resource.data.get('history', []))
          || (isRevoked(groupId) &&
          resource.data.ownerId == request.auth.uid &&
          resource.data.assigneeId == request.auth.uid &&
          request.resource.data.get('isDeleted', false) == true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isDeleted', 'updateAt']));
        // Only the creator, and only while they still hold it: once a shift has been handed to
        // someone else it is theirs to cover, and deleting it out from under them is not the
        // creator's call. Giving it back is putting it up for swap, not deleting it.
        allow delete: if (isMember(groupId) || isRevoked(groupId)) &&
          resource.data.ownerId == request.auth.uid &&
          resource.data.assigneeId == request.auth.uid;
      }

      // When each month of the group's calendar last changed: any member's write moves it.
      // A revoked user is in here too: they read it to tell whether their cache is behind, and
      // their soft delete commits the month's marker in the same batch. It holds only timestamps.
      match /sync/{docId} {
        allow read: if isMember(groupId) || isRevoked(groupId);
        allow write: if isMember(groupId) || isRevoked(groupId);
      }

      // Join requests: created only by requestToJoinGroup (Cloud Function).
      match /joinRequests/{requestUid} {
        allow read: if isAdmin(groupId) || (isSignedIn() && request.auth.uid == requestUid);
        allow create: if false;
        allow delete: if isAdmin(groupId) || (isSignedIn() && request.auth.uid == requestUid);
        allow update: if false;
      }
    }
  }
}
