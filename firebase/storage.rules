rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // A profile photo, at `profilePhotos/{uid}/{photoId}.webp`. Any signed-in user may see it, as
    // they may see the name and the animal on `users/{uid}`; nobody without a session may.
    //
    // The owner only ever creates: a new photo is a new id, so a path never changes and a cache can
    // keep it forever. Replacing and removing are `setProfilePhoto`'s, through the Admin SDK, which
    // these rules do not bind. Nothing here asks Firestore anything, since a cross-service lookup
    // bills a Firestore read on every image load.
    match /profilePhotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.size <= 100 * 1024 &&
        request.resource.contentType == 'image/webp' &&
        fileName.matches('^[A-Za-z0-9_-]{1,64}\\.webp$');
      allow update, delete: if false;
    }
  }
}
