# Copy to keystore.properties (git-ignored) and fill in the upload key. Relative paths are resolved
# against the project root; keep the keystore itself outside the repository.
#
# CI sets the same four values as TURNIA_UPLOAD_STORE_FILE, TURNIA_UPLOAD_STORE_PASSWORD,
# TURNIA_UPLOAD_KEY_ALIAS and TURNIA_UPLOAD_KEY_PASSWORD instead.
storeFile=/absolute/path/to/turnia-upload.jks
storePassword=
keyAlias=upload
keyPassword=
