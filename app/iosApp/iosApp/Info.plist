<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- iOS only reports a device language the bundle declares; without this Compose resources
	     would always see English and never load values-es. Keep it in step with composeResources. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>de</string>
		<string>it</string>
	</array>
	<!-- AdMob, test or real by build configuration (Configuration/Config.xcconfig). The SDK
	     crashes the app on start without the app id; AdBanner.swift reads the banner unit. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<key>AdMobBannerUnitId</key>
	<string>$(ADMOB_BANNER_UNIT_ID)</string>
	<!-- Deactivated in Debug, by build configuration (Configuration/Config.xcconfig). -->
	<key>FIREBASE_ANALYTICS_COLLECTION_DEACTIVATED</key>
	<string>$(ANALYTICS_COLLECTION_DEACTIVATED)</string>
	<!-- iOS OAuth client id (from GoogleService-Info.plist CLIENT_ID). The GoogleSignIn
	     SDK reads this to build its active configuration; KMPAuth never sets one itself,
	     so without this key signInWithPresentingViewController has no configuration and fails.
	     It and the URL scheme below are the same id in two spellings, and the SDK refuses to
	     present the sign-in sheet unless they agree — change one and you must change the other. -->
	<key>GIDClientID</key>
	<string>570433560233-085g4o2j74b7fh5n5fhcp3pse3ptbc3e.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>GoogleSignIn</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.570433560233-085g4o2j74b7fh5n5fhcp3pse3ptbc3e</string>
			</array>
		</dict>
		<!-- How the invitation link's landing page opens the app. The https link itself cannot,
		     until Universal Links are signed (paid Apple Developer Program). Must match
		     InvitationLinkConfig.SCHEME. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>InvitationLink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>turnia</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
