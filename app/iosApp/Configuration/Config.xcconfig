TEAM_ID=83GQ2T4N4H

PRODUCT_NAME=Turnia
PRODUCT_BUNDLE_IDENTIFIER=com.geoviksoft.turnia.Turnia

CURRENT_PROJECT_VERSION=4
MARKETING_VERSION=1.03

// AdMob, read through Info.plist. Debug uses Google's test app and banner: a new or unapproved real
// unit serves nothing, and clicking a real ad from a development device gets the account flagged.
ADMOB_APP_ID[config=Debug] = ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_UNIT_ID[config=Debug] = ca-app-pub-3940256099942544/2435281174
ADMOB_APP_ID[config=Release] = ca-app-pub-8803819741412121~7996285292
// calendar_groups_people_banner
ADMOB_BANNER_UNIT_ID[config=Release] = ca-app-pub-8803819741412121/3305222086

// Analytics, read through Info.plist. No Debug build reports to it, so development runs never
// reach the production stream this bundle id shares with the App Store build.
ANALYTICS_COLLECTION_DEACTIVATED[config=Debug] = YES
ANALYTICS_COLLECTION_DEACTIVATED[config=Release] = NO
