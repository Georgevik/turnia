<resources>
    <string name="app_name">Turnia</string>
    <string-array name="loading_phrases">
        <item>Verhandle mit dem Schicksal (und mit der Kollegin vom Nachtdienst)…</item>
        <item>Richte die Sterne aus… und die Dienstpläne des Teams.</item>
        <item>Löse die Quantenphysik eines komplett freien Wochenendes.</item>
        <item>Setze Dienste besser zusammen als bei einer Runde Tetris.</item>
        <item>Warte auf das Wunder eines Dienstplans, der allen passt…</item>
        <item>Berechne, wie viele Kaffees diese Woche brauchen wird.</item>
        <item>Tausche Früh- gegen Spätdienste und rette Pläne in letzter Minute…</item>
        <item>Ordne die Zeit neu, damit du endlich ein Sozialleben hast.</item>
        <item>Starte die Diplomatie des Diensttauschs…</item>
        <item>Prüfe den Dienstplan: eine Sekunde, gleich haben wir's.</item>
        <item>Tausche den Nachtdienst gegen ein Stück Kuchen...</item>
        <item>Suche die mutige Seele, die den Feiertag übernimmt...</item>
        <item>Sortiere die Teile des Wochenpuzzles neu.</item>
        <item>Synchronisiere die Uhren und vermeide mysteriöse Überschneidungen.</item>
        <item>Prüfe, ob ein freier Freitag Mythos oder Wirklichkeit ist.</item>
        <item>Verwandle Dienstplan-Chaos in Gelassenheit.</item>
        <item>Füge die Teile zusammen, bevor jemand um einen Tausch bittet.</item>
        <item>Berechne die Chancen auf zwei freie Tage am Stück.</item>
        <item>Passe den Dienstplan an, damit alle durchatmen können.</item>
        <item>Rolle den roten Teppich für deinen nächsten freien Tag aus.</item>
    </string-array>

