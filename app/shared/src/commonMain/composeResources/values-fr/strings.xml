<resources>
    <string name="app_name">Turnia</string>
    <string-array name="loading_phrases">
        <item>Négociation avec le destin (et avec ton collègue de nuit)…</item>
        <item>Alignement des étoiles… et des plannings de l'équipe.</item>
        <item>Résolution de la physique quantique d'un week-end entier de repos.</item>
        <item>Emboîtement des gardes, mieux qu'une partie de Tetris.</item>
        <item>En attente du miracle d'un planning qui convient à tout le monde…</item>
        <item>Calcul du nombre de cafés qu'il faudra cette semaine.</item>
        <item>Échange des matins contre des après-midis et sauvetage des plans de dernière minute…</item>
        <item>Réorganisation du temps pour que tu aies enfin une vie sociale.</item>
        <item>Lancement de la diplomatie des échanges de garde…</item>
        <item>Vérification du planning : une seconde, on y est presque.</item>
        <item>Échange de la garde de nuit contre une part de gâteau...</item>
        <item>Recherche de l'âme courageuse qui couvrira le jour férié...</item>
        <item>Réagencement des pièces du puzzle de la semaine.</item>
        <item>Synchronisation des horloges pour éviter les chevauchements mystérieux.</item>
        <item>Vérification : un vendredi de repos, mythe ou réalité ?</item>
        <item>Transformation du chaos des plannings en tranquillité.</item>
        <item>Assemblage des pièces avant que quelqu'un demande un échange.</item>
        <item>Calcul des chances d'avoir deux jours de repos d'affilée.</item>
        <item>Ajustement du planning pour que tout le monde puisse respirer.</item>
        <item>Déroulement du tapis rouge pour ton prochain jour de repos.</item>
    </string-array>

