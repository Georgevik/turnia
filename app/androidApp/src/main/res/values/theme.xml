<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The native splash screen, shown while the app starts. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <!-- No icon on the native splash: Compose draws its own. -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <!-- AppCompat because MainActivity is an AppCompatActivity, for the per-app language. -->
    <style name="Theme.App" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="backgroundTint">@android:color/black</item>
    </style>
</resources>
