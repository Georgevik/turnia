<?xml version="1.0" encoding="utf-8"?>
<!-- The Firebase emulators the E2E tests run against speak plain http, from the host as seen by the
     Android emulator. Debug only: a release build never talks to anything but Google over https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
