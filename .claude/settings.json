{
  "permissions": {
    "deny": [
      "Bash(firebase deploy*)",
      "Bash(npx firebase deploy*)",
      "Bash(gh workflow run release*)",
      "Bash(gh workflow run Release*)",
      "Bash(gh release create*)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_production.py\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
